[gd_scene format=3]

[ext_resource type="Script" path="res://ui/upgrade_card.gd" id="1"]

[node name="UpgradeCard" type="PanelContainer"]
theme_type_variation = &"Card"
script = ExtResource("1")

[node name="HBox" type="HBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 8

[node name="VBox" type="VBoxContainer" parent="HBox"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 4
theme_override_constants/separation = 3

[node name="Name" type="Label" parent="HBox/VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"SilkBold"
theme_override_font_sizes/font_size = 10
text = "HEAVY PRESS"

[node name="Desc" type="Label" parent="HBox/VBox"]
unique_name_in_owner = true
custom_minimum_size = Vector2(120, 0)
layout_mode = 2
theme_override_colors/font_color = Color(0.6039, 0.5882, 0.549, 1)
theme_override_font_sizes/font_size = 12
text = "+1 grey box per press."
autowrap_mode = 3

[node name="Btn" type="Button" parent="HBox"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 4
mouse_default_cursor_shape = 2
theme_type_variation = &"BtnGrey"
theme_override_font_sizes/font_size = 9
text = "$40.00"
