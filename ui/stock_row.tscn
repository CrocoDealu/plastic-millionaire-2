[gd_scene format=3]

[ext_resource type="Script" path="res://ui/stock_row.gd" id="1_script"]
[ext_resource type="Script" path="res://ui/pixel_swatch.gd" id="2_swatch"]

[node name="StockRow" type="HBoxContainer"]
mouse_filter = 2
theme_override_constants/separation = 8
script = ExtResource("1_script")

[node name="Swatch" type="Control" parent="."]
unique_name_in_owner = true
custom_minimum_size = Vector2(12, 12)
layout_mode = 2
size_flags_vertical = 4
mouse_filter = 2
script = ExtResource("2_swatch")
bevel = false

[node name="Name" type="Label" parent="."]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"Body15"
text = "Plastic"
clip_text = true
text_overrun_behavior = 3

[node name="Price" type="Label" parent="."]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"Body14"
theme_override_colors/font_color = Color(0.541176, 0.576471, 0.721569, 1)
text = "$1"
