[gd_scene format=3]

[ext_resource type="Script" path="res://ui/nav_card.gd" id="1_script"]

[node name="NavCard" type="Button"]
custom_minimum_size = Vector2(0, 80)
focus_mode = 0
mouse_default_cursor_shape = 2
theme_type_variation = &"NavCyan"
script = ExtResource("1_script")

[node name="Content" type="MarginContainer" parent="."]
unique_name_in_owner = true
layout_mode = 1
anchors_preset = 10
anchor_right = 1.0
grow_horizontal = 2
mouse_filter = 2
theme_override_constants/margin_left = 15
theme_override_constants/margin_top = 15
theme_override_constants/margin_right = 15
theme_override_constants/margin_bottom = 15

[node name="VBox" type="VBoxContainer" parent="Content"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 6

[node name="Header" type="HBoxContainer" parent="Content/VBox"]
layout_mode = 2
mouse_filter = 2

[node name="Title" type="Label" parent="Content/VBox/Header"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"Px12"
text = "PRODUCTION"

[node name="Badge" type="PanelContainer" parent="Content/VBox/Header"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 4
mouse_filter = 2
theme_type_variation = &"BadgeGreen"

[node name="BadgeLabel" type="Label" parent="Content/VBox/Header/Badge"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"Px9"
theme_override_colors/font_color = Color(0.364706, 1, 0.541176, 1)
text = "0/3"

[node name="Sub" type="Label" parent="Content/VBox"]
unique_name_in_owner = true
custom_minimum_size = Vector2(1, 0)
layout_mode = 2
theme_type_variation = &"Body14"
theme_override_colors/font_color = Color(0.541176, 0.576471, 0.721569, 1)
text = "0 of 3 machines running."
autowrap_mode = 3
