[node name="Bar" type="ProgressBar" parent="VBox"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 6)
layout_mode = 2
mouse_filter = 2
theme_override_styles/background = SubResource("bar_bg")
theme_override_styles/fill = SubResource("bar_fill")
show_percentage = false

[node name="Rate" type="Label" parent="VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.7412, 0.7216, 0.6784, 1)
text = "+0.50 GRY/s"

[node name="Autos" type="HBoxContainer" parent="VBox"]
unique_name_in_owner = true
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 4

[node name="InTag" type="PanelContainer" parent="VBox/Autos"]
unique_name_in_owner = true
layout_mode = 2
mouse_default_cursor_shape = 2
theme_override_styles/panel = SubResource("tag_off")

[node name="HBox" type="HBoxContainer" parent="VBox/Autos/InTag"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 4

[node name="Dot" type="ColorRect" parent="VBox/Autos/InTag/HBox"]
custom_minimum_size = Vector2(5, 5)
layout_mode = 2
size_flags_vertical = 4
mouse_filter = 2

[node name="Label" type="Label" parent="VBox/Autos/InTag/HBox"]
layout_mode = 2
theme_type_variation = &"Silk"
theme_override_font_sizes/font_size = 7
text = "IN"

[node name="OutTag" type="PanelContainer" parent="VBox/Autos"]
unique_name_in_owner = true
layout_mode = 2
mouse_default_cursor_shape = 2
theme_override_styles/panel = SubResource("tag_off")

[node name="HBox" type="HBoxContainer" parent="VBox/Autos/OutTag"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 4

[node name="Dot" type="ColorRect" parent="VBox/Autos/OutTag/HBox"]
custom_minimum_size = Vector2(5, 5)
layout_mode = 2
size_flags_vertical = 4
mouse_filter = 2

[node name="Label" type="Label" parent="VBox/Autos/OutTag/HBox"]
layout_mode = 2
theme_type_variation = &"Silk"
theme_override_font_sizes/font_size = 7
text = "OUT"

[node name="Actions" type="HBoxContainer" parent="VBox"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 6

[node name="Act" type="Button" parent="VBox/Actions"]
unique_name_in_owner = true
custom_minimum_size = Vector2(100, 0)
layout_mode = 2
mouse_default_cursor_shape = 2
theme_type_variation = &"BtnGrey"
theme_override_font_sizes/font_size = 9
text = "RUN"
clip_text = true

[node name="Buy" type="Button" parent="VBox/Actions"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
mouse_default_cursor_shape = 2
theme_type_variation = &"BtnGrey"
script = ExtResource("cb")

[node name="HBox" type="HBoxContainer" parent="VBox/Actions/Buy"]
layout_mode = 0
mouse_filter = 2

[node name="Label" type="Label" parent="VBox/Actions/Buy/HBox"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"SilkBold"
theme_override_font_sizes/font_size = 10
text = "BUY ×1"

[node name="Cost" type="Label" parent="VBox/Actions/Buy/HBox"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"SilkBold"
theme_override_font_sizes/font_size = 10
text = "$12.00"
