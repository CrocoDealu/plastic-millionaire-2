mouse_filter = 2

[node name="Label" type="Label" parent="VBox/Recipe/In1/HBox"]
layout_mode = 2
theme_type_variation = &"Silk"
theme_override_colors/font_color = Color(0.9255, 0.9098, 0.8745, 1)
text = "3 GRY"

[node name="NoInput" type="Label" parent="VBox/Recipe"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 4
theme_type_variation = &"Silk"
theme_override_colors/font_color = Color(0.4667, 0.4549, 0.4235, 1)
text = "NO INPUT"

[node name="Arrow" type="Label" parent="VBox/Recipe"]
layout_mode = 2
size_flags_vertical = 4
theme_type_variation = &"Silk"
theme_override_colors/font_color = Color(0.4667, 0.4549, 0.4235, 1)
text = "→"

[node name="Out" type="PanelContainer" parent="VBox/Recipe"]
unique_name_in_owner = true
layout_mode = 2
mouse_filter = 2
theme_type_variation = &"Pill"

[node name="HBox" type="HBoxContainer" parent="VBox/Recipe/Out"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 4

[node name="Dot" type="ColorRect" parent="VBox/Recipe/Out/HBox"]
custom_minimum_size = Vector2(8, 8)
layout_mode = 2
size_flags_vertical = 4
mouse_filter = 2

[node name="Label" type="Label" parent="VBox/Recipe/Out/HBox"]
layout_mode = 2
theme_type_variation = &"Silk"
theme_override_colors/font_color = Color(0.9255, 0.9098, 0.8745, 1)
text = "3 GRY"

[node name="Every" type="Label" parent="VBox/Recipe"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 4
theme_type_variation = &"Silk"
theme_override_colors/font_color = Color(0.4667, 0.4549, 0.4235, 1)
