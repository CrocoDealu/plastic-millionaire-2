[ext_resource type="PackedScene" path="res://ui/settings_modal.tscn" id="10"]

[sub_resource type="Shader" id="scan_shader"]
code = "shader_type canvas_item;
// 1px black line every 3 canvas pixels at 10% (CSS repeating-linear-gradient(#000 0 1px, transparent 1px 3px)).
uniform float height = 800.0;
void fragment() {
	COLOR = vec4(0.0, 0.0, 0.0, mod(floor(UV.y * height), 3.0) < 1.0 ? 0.1 : 0.0);
}
"

[sub_resource type="ShaderMaterial" id="scan"]
shader = SubResource("scan_shader")

[node name="Main" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
script = ExtResource("1")

[node name="Bg" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
mouse_filter = 2
color = Color(0.149, 0.149, 0.1647, 1)

[node name="Grid" type="TextureRect" parent="."]
unique_name_in_owner = true
layout_mode = 0
offset_left = -400.0
offset_top = -300.0
offset_right = 1280.0
offset_bottom = 800.0
mouse_filter = 2
texture = ExtResource("2")
stretch_mode = 1

[node name="Drift" type="Control" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
mouse_filter = 2
script = ExtResource("3")

[node name="Layout" type="VBoxContainer" parent="."]
