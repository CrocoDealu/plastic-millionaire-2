[gd_scene format=3]

[ext_resource type="Script" path="res://main.gd" id="1"]
[ext_resource type="Texture2D" path="res://assets/ui/arcade/BackgroundGrid.png" id="2"]
[ext_resource type="Script" path="res://ui/drift.gd" id="3"]
[ext_resource type="Texture2D" path="res://assets/ui/icon_settings.png" id="4"]
